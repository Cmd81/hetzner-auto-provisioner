# توکن پروژه را از Hetzner Console > Project > Security > API Tokens بسازید.
# دسترسی توکن باید Read & Write باشد.
HETZNER_API_TOKEN=YOUR_HETZNER_TOKEN

# فاصله بررسی موجودی برحسب ثانیه؛ پیشنهاد: 60 ثانیه
POLL_INTERVAL_SECONDS=60

# سیستم‌عامل تمامی سرورهای جدید (مستقیماً توسط هتزنر نصب می‌شود)
SERVER_IMAGE=ubuntu-22.04

# قالب: TYPE@LOCATION=COUNT
# چند مورد را با ویرگول جدا کنید؛ کاهش تعداد موجب حذف سرورهای قبلی نمی‌شود.
TARGETS=cx23@fsn1=1,cx23@nbg1=1

# پیشوند ثابت نام سرورها؛ بدون دلیل تغییر ندهید.
NAME_PREFIX=hcloud-auto

# نام یا شناسه کلید SSH که از قبل در پروژه هتزنر ثبت شده است؛ اختیاری
SSH_KEYS=

# برای اجازه ساخت خودکار سرورهای هزینه‌دار، مقدار را true کنید.
AUTO_CREATE=false

# حداکثر تعداد درخواست ساخت در هر دور بررسی
MAX_CREATES_PER_CYCLE=1

# ذخیره وضعیت برای جلوگیری از ساخت مجدد جایگاه‌های تکمیل‌شده
STATE_FILE=/var/lib/hetzner-auto-provisioner/state.json
