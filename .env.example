# Generate a Read & Write token in Hetzner Console > Project > Security > API Tokens
HETZNER_API_TOKEN=YOUR_HETZNER_TOKEN

# Recommended: 60 seconds (Hetzner rate limit is per project)
POLL_INTERVAL_SECONDS=60

# Default operating system for ALL created servers
SERVER_IMAGE=ubuntu-22.04

# TYPE@LOCATION=QUANTITY, separate targets with a comma.
# Add/remove targets or set COUNT. No automatic deletion if COUNT decreases.
TARGETS=cx23@fsn1=1,cx23@nbg1=1

# Existing server names use this stable prefix. Do not change casually.
NAME_PREFIX=hcloud-auto

# Names or IDs of SSH keys ALREADY registered in your Hetzner project (optional)
SSH_KEYS=

# Explicitly change to true to allow BILLABLE server creation.
AUTO_CREATE=false

# Additional safety cap: create at most this many servers per poll cycle.
MAX_CREATES_PER_CYCLE=1

# State prevents recreating already-successfully-provisioned slots even after deletion.
STATE_FILE=/var/lib/hetzner-auto-provisioner/state.json
